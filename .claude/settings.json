{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-client-writes.sh",
            "onFailure": "block",
            "statusMessage": "Checking client-write guardrail"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-secrets.sh",
            "onFailure": "block",
            "statusMessage": "Checking secrets guardrail"
          }
        ]
      }
    ]
  }
}
